{
  "name": "@vrealtime/server",
  "version": "0.2.0",
  "description": "vRealTime server: attach any WebSocket, Node serve(), Cloudflare Workers and Durable Objects",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/austinchennn/vRT.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/austinchennn/vRT#readme",
  "bugs": "https://github.com/austinchennn/vRT/issues",
  "keywords": [
    "realtime",
    "voice",
    "agent",
    "websocket",
    "vrealtime"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@vrealtime/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "@vrealtime/source": "./src/node/index.ts",
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./workers": {
      "@vrealtime/source": "./src/workers/index.ts",
      "types": "./dist/workers/index.d.ts",
      "default": "./dist/workers/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@vrealtime/core": "0.2.0",
    "@vrealtime/protocol": "0.2.0"
  },
  "peerDependencies": {
    "ws": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "ws": {
      "optional": true
    }
  }
}
