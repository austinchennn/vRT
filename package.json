{
  "name": "vrealtime-monorepo",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run packages",
    "build": "node scripts/build.mjs",
    "check:budgets": "node scripts/check-budgets.mjs",
    "check:spec": "node scripts/check-spec.mjs",
    "bench": "node scripts/bench.mjs",
    "bench:latency": "node scripts/bench-latency.mjs",
    "test:e2e": "vitest run examples/minimal",
    "pack": "node scripts/pack.mjs",
    "test:consumer": "node scripts/consumer-smoke.mjs",
    "test:workers": "npm run build && vitest run examples/workers"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "22.18.0",
    "@types/react": "^19.3.0",
    "@types/ws": "^8.18.1",
    "ai": "^7.0.142",
    "ajv": "8.20.0",
    "esbuild": "0.25.10",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "ws": "^8.18.3"
  }
}
