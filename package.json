{
  "name": "vrealtime-monorepo",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*",
    "conformance"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p conformance/tsconfig.json",
    "test": "vitest run packages",
    "build": "node scripts/build.mjs",
    "check:budgets": "node scripts/check-budgets.mjs",
    "check:spec": "node scripts/check-spec.mjs",
    "bench": "node scripts/bench.mjs",
    "bench:latency": "node scripts/bench-latency.mjs",
    "test:e2e": "vitest run examples/minimal",
    "test:live": "vitest run --config live/vitest.config.ts",
    "pack": "node scripts/pack.mjs",
    "test:consumer": "node scripts/consumer-smoke.mjs",
    "publish:dry-run": "node scripts/publish.mjs --dry-run",
    "version:set": "node scripts/set-version.mjs",
    "test:workers": "npm run build && vitest run examples/workers",
    "build:conformance": "npm run build && npm run build -w @vrealtime/conformance",
    "typecheck:conformance": "tsc -p conformance/tsconfig.json",
    "test:conformance": "npm run build:conformance && npm run typecheck:conformance && npm test -w @vrealtime/conformance",
    "pack:conformance": "npm run build:conformance && npm run pack:local -w @vrealtime/conformance",
    "test:conformance:consumer": "node conformance/test/consumer.mjs"
  },
  "devDependencies": {
    "@ai-sdk/openai": "4.0.95",
    "@testing-library/react": "^16.3.3",
    "@types/node": "22.18.0",
    "@types/react": "^19.3.0",
    "@types/ws": "^8.18.1",
    "ai": "^7.0.142",
    "ajv": "8.20.0",
    "esbuild": "0.25.10",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "ws": "^8.18.3"
  }
}
