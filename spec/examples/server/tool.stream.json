{
  "$schema": "../vectors.schema.json",
  "suite": "control",
  "direction": "server",
  "description": "The tool.stream message, sent only when tool-stream-v1 is in effect (protocol.md §7.5).",
  "cases": [
    { "id": "server/tool.stream/start", "description": "The first message about a call.", "valid": true, "message": { "v": 1, "seq": 9, "type": "tool.stream", "callId": "call-1", "epoch": 2, "turnId": "turn-2", "name": "insert_table", "phase": "start" } },
    { "id": "server/tool.stream/arguments-delta", "description": "A fragment of the arguments as the model generates them.", "valid": true, "message": { "v": 1, "seq": 10, "type": "tool.stream", "callId": "call-1", "epoch": 2, "turnId": "turn-2", "name": "insert_table", "phase": "arguments-delta", "delta": "{\"after\":\"block-7\",\"col" } },
    { "id": "server/tool.stream/arguments-delta-empty", "description": "An empty fragment is valid.", "valid": true, "message": { "v": 1, "seq": 10, "type": "tool.stream", "callId": "call-1", "epoch": 2, "turnId": "turn-2", "name": "insert_table", "phase": "arguments-delta", "delta": "" } },
    { "id": "server/tool.stream/arguments-complete", "description": "The complete arguments; the call is issued.", "valid": true, "message": { "v": 1, "seq": 11, "type": "tool.stream", "callId": "call-1", "epoch": 2, "turnId": "turn-2", "name": "insert_table", "phase": "arguments-complete", "arguments": { "after": "block-7", "columns": ["Item", "Cost"] } } },
    { "id": "server/tool.stream/arguments-complete-null", "description": "Arguments may be any JSON value, including null.", "valid": true, "message": { "v": 1, "seq": 11, "type": "tool.stream", "callId": "call-1", "epoch": 2, "turnId": "turn-2", "name": "reset", "phase": "arguments-complete", "arguments": null } },
    { "id": "server/tool.stream/progress", "description": "Progress a running server tool reported.", "valid": true, "message": { "v": 1, "seq": 12, "type": "tool.stream", "callId": "call-1", "epoch": 2, "turnId": "turn-2", "name": "search", "phase": "progress", "progress": { "found": 3 } } },
    { "id": "server/tool.stream/settled-ok", "description": "The call succeeded.", "valid": true, "message": { "v": 1, "seq": 13, "type": "tool.stream", "callId": "call-1", "epoch": 2, "turnId": "turn-2", "name": "insert_table", "phase": "settled", "ok": true } },
    { "id": "server/tool.stream/settled-failed", "description": "The call failed, with its code.", "valid": true, "message": { "v": 1, "seq": 13, "type": "tool.stream", "callId": "call-1", "epoch": 2, "turnId": "turn-2", "name": "insert_table", "phase": "settled", "ok": false, "code": "REJECTED" } },
    { "id": "server/tool.stream/cancelled", "description": "The turn was interrupted.", "valid": true, "message": { "v": 1, "seq": 13, "type": "tool.stream", "callId": "call-1", "epoch": 2, "turnId": "turn-2", "name": "insert_table", "phase": "cancelled" } },
    { "id": "server/tool.stream/failed", "description": "The model stopped before completing the arguments.", "valid": true, "message": { "v": 1, "seq": 13, "type": "tool.stream", "callId": "call-1", "epoch": 2, "turnId": "turn-2", "name": "insert_table", "phase": "failed", "message": "The response ended before the call was complete" } },
    { "id": "server/tool.stream/phase-unknown", "description": "Phases are a closed set.", "valid": false, "error": "INVALID_FIELD", "message": { "v": 1, "seq": 9, "type": "tool.stream", "callId": "call-1", "epoch": 2, "turnId": "turn-2", "name": "insert_table", "phase": "paused" } },
    { "id": "server/tool.stream/phase-missing", "description": "phase is required.", "valid": false, "error": "INVALID_FIELD", "message": { "v": 1, "seq": 9, "type": "tool.stream", "callId": "call-1", "epoch": 2, "turnId": "turn-2", "name": "insert_table" } },
    { "id": "server/tool.stream/delta-missing", "description": "arguments-delta carries delta.", "valid": false, "error": "INVALID_FIELD", "message": { "v": 1, "seq": 10, "type": "tool.stream", "callId": "call-1", "epoch": 2, "turnId": "turn-2", "name": "insert_table", "phase": "arguments-delta" } },
    { "id": "server/tool.stream/delta-object", "description": "delta is text, not parsed JSON.", "valid": false, "error": "INVALID_FIELD", "message": { "v": 1, "seq": 10, "type": "tool.stream", "callId": "call-1", "epoch": 2, "turnId": "turn-2", "name": "insert_table", "phase": "arguments-delta", "delta": { "after": "block-7" } } },
    { "id": "server/tool.stream/arguments-missing", "description": "arguments-complete carries arguments, null when there are none.", "valid": false, "error": "INVALID_FIELD", "message": { "v": 1, "seq": 11, "type": "tool.stream", "callId": "call-1", "epoch": 2, "turnId": "turn-2", "name": "insert_table", "phase": "arguments-complete" } },
    { "id": "server/tool.stream/progress-missing", "description": "progress carries progress.", "valid": false, "error": "INVALID_FIELD", "message": { "v": 1, "seq": 12, "type": "tool.stream", "callId": "call-1", "epoch": 2, "turnId": "turn-2", "name": "search", "phase": "progress" } },
    { "id": "server/tool.stream/settled-ok-missing", "description": "settled carries ok.", "valid": false, "error": "INVALID_FIELD", "message": { "v": 1, "seq": 13, "type": "tool.stream", "callId": "call-1", "epoch": 2, "turnId": "turn-2", "name": "insert_table", "phase": "settled" } },
    { "id": "server/tool.stream/settled-code-missing", "description": "A failed settle carries its code.", "valid": false, "error": "INVALID_FIELD", "message": { "v": 1, "seq": 13, "type": "tool.stream", "callId": "call-1", "epoch": 2, "turnId": "turn-2", "name": "insert_table", "phase": "settled", "ok": false } },
    { "id": "server/tool.stream/settled-code-unknown", "description": "Failure codes are a closed set.", "valid": false, "error": "INVALID_FIELD", "message": { "v": 1, "seq": 13, "type": "tool.stream", "callId": "call-1", "epoch": 2, "turnId": "turn-2", "name": "insert_table", "phase": "settled", "ok": false, "code": "BROKEN" } },
    { "id": "server/tool.stream/failed-message-missing", "description": "failed carries a message.", "valid": false, "error": "INVALID_FIELD", "message": { "v": 1, "seq": 13, "type": "tool.stream", "callId": "call-1", "epoch": 2, "turnId": "turn-2", "name": "insert_table", "phase": "failed" } },
    { "id": "server/tool.stream/turn-missing", "description": "turnId is required.", "valid": false, "error": "INVALID_FIELD", "message": { "v": 1, "seq": 9, "type": "tool.stream", "callId": "call-1", "epoch": 2, "name": "insert_table", "phase": "start" } },
    { "id": "server/tool.stream/seq-zero", "description": "tool.stream is sequenced.", "valid": false, "error": "INVALID_FIELD", "message": { "v": 1, "seq": 0, "type": "tool.stream", "callId": "call-1", "epoch": 2, "turnId": "turn-2", "name": "insert_table", "phase": "start" } }
  ]
}
