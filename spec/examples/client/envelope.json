{
  "$schema": "../vectors.schema.json",
  "suite": "control",
  "direction": "client",
  "description": "Framing and envelope rules that apply to every client message, and the order in which a receiver classifies errors (protocol.md §9.1).",
  "cases": [
    { "id": "client/envelope/invalid-json", "description": "A text frame that is not JSON.", "valid": false, "error": "MALFORMED", "raw": "{\"v\":1," },
    { "id": "client/envelope/empty-frame", "description": "An empty text frame.", "valid": false, "error": "MALFORMED", "raw": "" },
    { "id": "client/envelope/array", "description": "JSON that is not an object.", "valid": false, "error": "MALFORMED", "message": [1] },
    { "id": "client/envelope/string", "description": "A bare JSON string.", "valid": false, "error": "MALFORMED", "message": "ping" },
    { "id": "client/envelope/null", "description": "JSON null.", "valid": false, "error": "MALFORMED", "message": null },
    { "id": "client/envelope/version-2", "description": "Another major version.", "valid": false, "error": "UNSUPPORTED_VERSION", "message": { "v": 2, "seq": 0, "type": "ping" } },
    { "id": "client/envelope/version-missing", "description": "No version.", "valid": false, "error": "UNSUPPORTED_VERSION", "message": { "seq": 0, "type": "ping" } },
    { "id": "client/envelope/version-string", "description": "The version must be the number 1, not a string.", "valid": false, "error": "UNSUPPORTED_VERSION", "message": { "v": "1", "seq": 0, "type": "ping" } },
    { "id": "client/envelope/version-before-type", "description": "The version is checked before the type.", "valid": false, "error": "UNSUPPORTED_VERSION", "message": { "v": 2, "seq": 0, "type": "nope" } },
    { "id": "client/envelope/type-unknown", "description": "A type this direction does not define.", "valid": false, "error": "UNKNOWN_TYPE", "message": { "v": 1, "seq": 1, "type": "nope" } },
    { "id": "client/envelope/type-missing", "description": "No type.", "valid": false, "error": "UNKNOWN_TYPE", "message": { "v": 1, "seq": 1 } },
    { "id": "client/envelope/type-not-string", "description": "A type that is not a string.", "valid": false, "error": "UNKNOWN_TYPE", "message": { "v": 1, "seq": 1, "type": 7 } },
    { "id": "client/envelope/type-server-only", "description": "A server message type sent by a client.", "valid": false, "error": "UNKNOWN_TYPE", "message": { "v": 1, "seq": 0, "type": "pong" } },
    { "id": "client/envelope/type-object-key", "description": "Type names are matched exactly, never looked up as object keys.", "valid": false, "error": "UNKNOWN_TYPE", "message": { "v": 1, "seq": 1, "type": "toString" } },
    { "id": "client/envelope/type-before-seq", "description": "The type is checked before the sequence number.", "valid": false, "error": "UNKNOWN_TYPE", "message": { "v": 1, "seq": -1, "type": "nope" } },
    { "id": "client/envelope/seq-missing", "description": "No sequence number.", "valid": false, "error": "INVALID_FIELD", "message": { "v": 1, "type": "text", "text": "hi" } },
    { "id": "client/envelope/seq-negative", "description": "Sequence numbers are unsigned.", "valid": false, "error": "INVALID_FIELD", "message": { "v": 1, "seq": -1, "type": "text", "text": "hi" } },
    { "id": "client/envelope/seq-fraction", "description": "Sequence numbers are integers.", "valid": false, "error": "INVALID_FIELD", "message": { "v": 1, "seq": 1.5, "type": "text", "text": "hi" } },
    { "id": "client/envelope/seq-over-uint32", "description": "Sequence numbers fit in 32 bits.", "valid": false, "error": "INVALID_FIELD", "message": { "v": 1, "seq": 4294967296, "type": "text", "text": "hi" } },
    { "id": "client/envelope/seq-string", "description": "A sequence number that is a string.", "valid": false, "error": "INVALID_FIELD", "message": { "v": 1, "seq": "1", "type": "text", "text": "hi" } },
    { "id": "client/envelope/seq-max", "description": "The largest sequence number.", "valid": true, "message": { "v": 1, "seq": 4294967295, "type": "text", "text": "hi" } }
  ]
}
